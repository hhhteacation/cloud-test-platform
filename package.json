{
  "name": "sdk-video-compat-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch --env-file-if-exists=.env.local --import tsx apps/api/src/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc -p tsconfig.app.json && vite build",
    "build:api": "rm -rf apps/api/dist && tsc -p apps/api/tsconfig.json",
    "start:api": "node --env-file-if-exists=.env.local apps/api/dist/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web:real": "npm run dev:web",
    "backup:data": "node scripts/backup-cloud-test-data.mjs",
    "restore:data": "node scripts/restore-cloud-test-data.mjs",
    "report:orphans": "node scripts/report-orphan-artifacts.mjs",
    "dev:web:mock": "VITE_PLATFORM_MODE=mock vite --host 127.0.0.1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@fastify/multipart": "^10.1.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "antd": "^5.26.5",
    "fastify": "^5.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
