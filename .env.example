# 前端默认连接同源真实 API：/api。只有需要纯前端演示时才显式打开 Mock。
# VITE_PLATFORM_MODE=mock
# VITE_API_BASE_URL=/api

API_HOST=127.0.0.1
API_PORT=3000
# 不配置时不会自动登记或连接任何真机
# ADB_SERIAL=YOUR_EXPLICIT_USB_DEVICE_SERIAL
# ADB_PATH=/Users/your-name/Library/Android/sdk/platform-tools/adb
# AAPT_PATH=/Users/your-name/Library/Android/sdk/build-tools/36.0.0/aapt
# CLOUD_TEST_DATA_DIR=/absolute/path/to/data
# MAX_APK_BYTES=1073741824
# MAX_VIDEO_BYTES=4294967296

# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
# MIN_FREE_DISK_BYTES=10737418240
# MAX_CONCURRENT_UPLOADS=2
# MAX_PROCESS_OUTPUT_BYTES=4194304
# 单个设备执行的全量 Logcat 上限，默认 256 MiB
# MAX_LOGCAT_BYTES=268435456
# PROCESS_KILL_GRACE_MS=3000
